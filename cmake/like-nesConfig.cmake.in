# like-nes SDK (спека #24, В1). Пишется руками, а не install(EXPORT): цели дерева отдают
# абсолютные каталоги исходников, а у FetchContent-целей нет export-наборов. Данные ниже —
# из целей дерева при конфигурировании (cmake/sdk_links.cmake).

if(CMAKE_VERSION VERSION_LESS 3.21)
  set(like-nes_FOUND FALSE)
  set(like-nes_NOT_FOUND_MESSAGE "like-nes SDK needs CMake 3.21+ (depfile in add_custom_command)")
  return()
endif()

include(CMakeFindDependencyMacro)
find_dependency(Threads)

get_filename_component(_ln_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(_ln_lib "${_ln_prefix}/lib/like-nes")

@LIKE_NES_SDK_DATA@
# Префикс без одной библиотеки — отказ find_package с её именем, а не ошибка линкера про
# неразрешённый символ из неё же.
foreach(_ln_t IN LISTS _ln_static)
  if(NOT EXISTS "${_ln_lib}/${_ln_file_${_ln_t}}")
    set(like-nes_FOUND FALSE)
    set(like-nes_NOT_FOUND_MESSAGE
        "like-nes SDK at ${_ln_prefix} is missing library ${_ln_file_${_ln_t}} (Release)")
    return()
  endif()
endforeach()
# implib на Windows — тот же класс: без него ошибка линкера вместо отказа find_package. assetc —
# тоже: без него like_nes_bake упал бы на первой сборке игры, а не при поиске SDK.
set(_ln_assetc "bin/assetc")
if(WIN32)
  string(APPEND _ln_assetc ".exe")
endif()
set(_ln_needed "bin/${_ln_runtime}" "${_ln_assetc}")
if(WIN32)
  list(APPEND _ln_needed "lib/like-nes/${_ln_runtime}.lib")
endif()
foreach(_ln_f IN LISTS _ln_needed)
  if(NOT EXISTS "${_ln_prefix}/${_ln_f}")
    set(like-nes_FOUND FALSE)
    set(like-nes_NOT_FOUND_MESSAGE
        "like-nes SDK at ${_ln_prefix} is missing ${_ln_f}; install the sdk component from a Release build")
    return()
  endif()
endforeach()

# Debug — всё или ничего: половина набора смешала бы конфигурации в одном exe.
set(_ln_debug_missing "")
set(LIKE_NES_HAS_DEBUG FALSE)
foreach(_ln_t IN LISTS _ln_static)
  if(EXISTS "${_ln_lib}/debug/${_ln_file_${_ln_t}}")
    set(LIKE_NES_HAS_DEBUG TRUE)
  else()
    list(APPEND _ln_debug_missing "${_ln_file_${_ln_t}}")
  endif()
endforeach()
if(LIKE_NES_HAS_DEBUG AND _ln_debug_missing)
  set(like-nes_FOUND FALSE)
  set(like-nes_NOT_FOUND_MESSAGE
      "like-nes SDK at ${_ln_prefix} has a partial Debug set, missing: ${_ln_debug_missing}")
  return()
endif()

if(NOT TARGET like-nes::engine)
  add_library(like-nes::webgpu SHARED IMPORTED)
  set_target_properties(like-nes::webgpu PROPERTIES
    IMPORTED_LOCATION "${_ln_prefix}/bin/${_ln_runtime}"
    INTERFACE_COMPILE_DEFINITIONS "${_ln_defs_webgpu}")
  if(WIN32)
    set_target_properties(like-nes::webgpu PROPERTIES
      IMPORTED_IMPLIB "${_ln_lib}/${_ln_runtime}.lib")
  elseif(NOT APPLE)
    # Без SONAME у предсобранного .so CMake вшил бы в DT_NEEDED полный путь префикса.
    set_target_properties(like-nes::webgpu PROPERTIES IMPORTED_NO_SONAME TRUE)
  endif()

  foreach(_ln_t IN LISTS _ln_static)
    add_library(like-nes::${_ln_t} STATIC IMPORTED)
    set_target_properties(like-nes::${_ln_t} PROPERTIES
      IMPORTED_LOCATION "${_ln_lib}/${_ln_file_${_ln_t}}"
      IMPORTED_LINK_INTERFACE_LANGUAGES CXX
      INTERFACE_LINK_LIBRARIES "${_ln_links_${_ln_t}}"
      INTERFACE_COMPILE_DEFINITIONS "${_ln_defs_${_ln_t}}")
    if(LIKE_NES_HAS_DEBUG)
      set_target_properties(like-nes::${_ln_t} PROPERTIES
        IMPORTED_LOCATION_DEBUG "${_ln_lib}/debug/${_ln_file_${_ln_t}}")
    endif()
  endforeach()
  foreach(_ln_t IN LISTS _ln_interface)
    add_library(like-nes::${_ln_t} INTERFACE IMPORTED)
    set_target_properties(like-nes::${_ln_t} PROPERTIES
      INTERFACE_LINK_LIBRARIES "${_ln_links_${_ln_t}}"
      INTERFACE_COMPILE_DEFINITIONS "${_ln_defs_${_ln_t}}")
  endforeach()

  set(_ln_dirs "")
  foreach(_ln_d IN LISTS _ln_includes)
    list(APPEND _ln_dirs "${_ln_prefix}/${_ln_d}")
  endforeach()
  list(TRANSFORM _ln_engine PREPEND "like-nes::")
  # Заголовки движка в UTF-8 с кириллицей: без /utf-8 MSVC читает их в ANSI-кодировке системы.
  add_library(like-nes::engine INTERFACE IMPORTED)
  set_target_properties(like-nes::engine PROPERTIES
    INTERFACE_LINK_LIBRARIES "${_ln_engine}"
    INTERFACE_INCLUDE_DIRECTORIES "${_ln_dirs}"
    INTERFACE_COMPILE_FEATURES cxx_std_20
    INTERFACE_COMPILE_OPTIONS "$<$<CXX_COMPILER_ID:MSVC>:/utf-8>")
  add_library(like-nes::window INTERFACE IMPORTED)
  set_target_properties(like-nes::window PROPERTIES
    INTERFACE_LINK_LIBRARIES like-nes::glfw3webgpu
    INTERFACE_INCLUDE_DIRECTORIES "${_ln_prefix}/include/like-nes/third_party")
endif()

set(LIKE_NES_RUNTIME "${_ln_prefix}/bin/${_ln_runtime}")
set(LIKE_NES_LIBRARY_BUNDLE "${_ln_prefix}/share/like-nes/library.bundle")
set(LIKE_NES_ASSETC "${_ln_prefix}/${_ln_assetc}")

# Движок собран со статическим CRT (cmake/msvc_runtime.cmake): цель игры обязана взять тот же,
# иначе LNK2038. Рантайм wgpu кладётся рядом с exe, rpath смотрит туда же.
function(like_nes_add_game target)
  if(NOT TARGET ${target})
    message(FATAL_ERROR "like_nes_add_game: '${target}' is not a target")
  endif()
  # У multi-config генератора (Visual Studio, Ninja Multi-Config) конфигурация Debug есть всегда,
  # и без Debug-набора она молча взяла бы Release-библиотеки — LNK2038 вместо названной причины.
  get_property(_ln_multi GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
  if(MSVC AND NOT LIKE_NES_HAS_DEBUG AND (_ln_multi OR CMAKE_BUILD_TYPE STREQUAL "Debug"))
    message(FATAL_ERROR "like_nes_add_game: Debug on MSVC needs the Debug SDK libraries "
                        "(lib/like-nes/debug), this prefix has Release only; with a multi-config "
                        "generator use a single-config one (Ninja) and CMAKE_BUILD_TYPE=Release")
  endif()
  set_target_properties(${target} PROPERTIES
    MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
  if(APPLE)
    set_target_properties(${target} PROPERTIES BUILD_RPATH "@executable_path")
  elseif(NOT WIN32)
    set_target_properties(${target} PROPERTIES BUILD_RPATH "$ORIGIN")
  endif()
  add_custom_command(TARGET ${target} POST_BUILD
    COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${LIKE_NES_RUNTIME}" "$<TARGET_FILE_DIR:${target}>"
    VERBATIM)
endfunction()

include("${CMAKE_CURRENT_LIST_DIR}/like_nes_bake.cmake")
