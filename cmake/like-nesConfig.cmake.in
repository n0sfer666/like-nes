# like-nes SDK (спека #24, В1). Пишется руками, а не install(EXPORT): цели дерева отдают
# абсолютные каталоги исходников, а у FetchContent-целей нет export-наборов. Данные ниже —
# из целей дерева при конфигурировании (cmake/sdk_links.cmake).

if(CMAKE_VERSION VERSION_LESS 3.21)
  set(like-nes_FOUND FALSE)
  set(like-nes_NOT_FOUND_MESSAGE "like-nes SDK needs CMake 3.21+ (depfile in add_custom_command)")
  return()
endif()

include(CMakeFindDependencyMacro)
find_dependency(Threads)

get_filename_component(_ln_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(_ln_lib "${_ln_prefix}/lib/like-nes")

@LIKE_NES_SDK_DATA@
# Префикс одной платформы в сборке под другую слинковался бы с объектами чужой цели или упал бы
# посреди линковки — отказ find_package называет обе.
include("${CMAKE_CURRENT_LIST_DIR}/sdk_platform.cmake")
# ANDROID_ABI и ANDROID_PLATFORM_LEVEL задаёт тулчейн NDK; встроенная поддержка Android в CMake их не
# знает, и сверки ниже отвечали бы про пустую платформу.
if(CMAKE_SYSTEM_NAME STREQUAL "Android" AND NOT ANDROID_ABI)
  set(like-nes_FOUND FALSE)
  set(like-nes_NOT_FOUND_MESSAGE
      "like-nes SDK for Android needs -DCMAKE_TOOLCHAIN_FILE=<ndk>/build/cmake/android.toolchain.cmake")
  return()
endif()
like_nes_sdk_platform(_ln_here)
if(NOT _ln_here STREQUAL _ln_platform)
  set(like-nes_FOUND FALSE)
  string(CONCAT like-nes_NOT_FOUND_MESSAGE
      "like-nes SDK at ${_ln_prefix} is built for ${_ln_platform}, this build targets ${_ln_here}; "
      "install the sdk component from a ${_ln_here} build of the engine tree")
  return()
endif()
# Префикс без одной библиотеки — отказ find_package с её именем, а не ошибка линкера про
# неразрешённый символ из неё же.
foreach(_ln_t IN LISTS _ln_static)
  if(NOT EXISTS "${_ln_lib}/${_ln_file_${_ln_t}}")
    set(like-nes_FOUND FALSE)
    set(like-nes_NOT_FOUND_MESSAGE
        "like-nes SDK at ${_ln_prefix} is missing library ${_ln_file_${_ln_t}} (Release)")
    return()
  endif()
endforeach()
# Debug — всё или ничего: половина набора смешала бы конфигурации в одном exe.
set(_ln_debug_missing "")
set(LIKE_NES_HAS_DEBUG FALSE)
foreach(_ln_t IN LISTS _ln_static)
  if(EXISTS "${_ln_lib}/debug/${_ln_file_${_ln_t}}")
    set(LIKE_NES_HAS_DEBUG TRUE)
  else()
    list(APPEND _ln_debug_missing "${_ln_file_${_ln_t}}")
  endif()
endforeach()
if(LIKE_NES_HAS_DEBUG AND _ln_debug_missing)
  set(like-nes_FOUND FALSE)
  set(like-nes_NOT_FOUND_MESSAGE
      "like-nes SDK at ${_ln_prefix} has a partial Debug set, missing: ${_ln_debug_missing}")
  return()
endif()

# Окно и рантайм wgpu на десктопе, оболочка и упаковка на мобиле. Отказ платформенной части —
# `_ln_fail`, до того как она создаст хоть одну цель.
set(_ln_fail "")
if(_ln_platform STREQUAL "desktop")
  include("${CMAKE_CURRENT_LIST_DIR}/sdk_config_desktop.cmake")
else()
  include("${CMAKE_CURRENT_LIST_DIR}/sdk_config_mobile.cmake")
endif()
if(_ln_fail)
  set(like-nes_FOUND FALSE)
  set(like-nes_NOT_FOUND_MESSAGE "${_ln_fail}")
  return()
endif()

if(NOT TARGET like-nes::engine)
  foreach(_ln_t IN LISTS _ln_static)
    add_library(like-nes::${_ln_t} STATIC IMPORTED)
    set_target_properties(like-nes::${_ln_t} PROPERTIES
      IMPORTED_LOCATION "${_ln_lib}/${_ln_file_${_ln_t}}"
      IMPORTED_LINK_INTERFACE_LANGUAGES CXX
      INTERFACE_LINK_LIBRARIES "${_ln_links_${_ln_t}}"
      INTERFACE_COMPILE_DEFINITIONS "${_ln_defs_${_ln_t}}")
    if(LIKE_NES_HAS_DEBUG)
      set_target_properties(like-nes::${_ln_t} PROPERTIES
        IMPORTED_LOCATION_DEBUG "${_ln_lib}/debug/${_ln_file_${_ln_t}}")
    endif()
  endforeach()
  foreach(_ln_t IN LISTS _ln_interface)
    add_library(like-nes::${_ln_t} INTERFACE IMPORTED)
    set_target_properties(like-nes::${_ln_t} PROPERTIES
      INTERFACE_LINK_LIBRARIES "${_ln_links_${_ln_t}}"
      INTERFACE_COMPILE_DEFINITIONS "${_ln_defs_${_ln_t}}")
  endforeach()

  set(_ln_dirs "")
  foreach(_ln_d IN LISTS _ln_includes)
    list(APPEND _ln_dirs "${_ln_prefix}/${_ln_d}")
  endforeach()
  list(TRANSFORM _ln_engine PREPEND "like-nes::")
  # Заголовки движка в UTF-8 с кириллицей: без /utf-8 MSVC читает их в ANSI-кодировке системы.
  add_library(like-nes::engine INTERFACE IMPORTED)
  set_target_properties(like-nes::engine PROPERTIES
    INTERFACE_LINK_LIBRARIES "${_ln_engine}"
    INTERFACE_INCLUDE_DIRECTORIES "${_ln_dirs}"
    INTERFACE_COMPILE_FEATURES cxx_std_20
    INTERFACE_COMPILE_OPTIONS "$<$<CXX_COMPILER_ID:MSVC>:/utf-8>")
endif()

set(LIKE_NES_LIBRARY_BUNDLE "${_ln_prefix}/share/like-nes/library.bundle")

include("${CMAKE_CURRENT_LIST_DIR}/like_nes_bake.cmake")
