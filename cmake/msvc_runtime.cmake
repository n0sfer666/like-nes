# Статический CRT на MSVC (спека #20, вертикаль 5, решение владельца от 2026-09-05).
#
# На чистой Windows нашему пакету не хватало `VCRUNTIME140.dll`: она приезжает с VC++
# Redistributable, которого там нет. Статическая линковка снимает эту зависимость с НАШИХ целей
# целиком — вместе с UCRT, потому что `/MT` тянет и его (libucrt.lib), — и не требует от человека
# ставить что-либо до запуска редактора.
#
# Файл включается ДО зависимостей: выбор рантайма — свойство КАЖДОЙ цели, и glfw, imgui, flecs,
# basisu и miniaudio обязаны получить тот же. Смешанный CRT в одном образе даёт две кучи и два
# набора дескрипторов: указатель, выданный одной половиной и освобождённый другой, падает не там,
# где ошибка, и не всегда.
#
# Одна граница смешанного CRT после этого ОСТАЁТСЯ, и вертикаль её СОЗДАЁТ, а не устраняет:
# предсобранный `wgpu_native.dll` собран чужим тулчейном с динамическим рантаймом, пересобрать его
# нечем, и в одном процессе живут две кучи — наша статическая и его. Безопасно это ровно потому,
# что через границу не проходит ВЛАДЕНИЕ: каждый объект wgpu (буфер, текстура, энкодер, модуль)
# освобождается его же `wgpu*Release`, память отображённого буфера читается между
# `wgpuBufferGetConstMappedRange` и `wgpuBufferUnmap` и нам не принадлежит, а строки в его
# структурах живут в его куче. Мы не отдаём ему указателей, которые он освободит, не освобождаем
# полученных от него и не передаём через границу ни `FILE*`, ни дескрипторов CRT — то есть ни один
# из тех способов, какими смешанный рантайм действительно роняет процесс. Появится в API wgpu
# первый объект со СВОБОДНЫМ владением — это решение придётся пересматривать, а не дополнять.
#
# Величина задаётся ДВАЖДЫ, и это не перестраховка ради красоты. `CMAKE_MSVC_RUNTIME_LIBRARY` знает
# только политика CMP0091 в состоянии NEW; зависимость, объявившая `cmake_minimum_required` ниже
# 3.15 (а ниже 3.10 её поднимает CMAKE_POLICY_VERSION_MINIMUM в корневом CMakeLists), видит эту
# политику в OLD и берёт флаг из `CMAKE_<LANG>_FLAGS_<CONFIG>` — то есть абстракцию не читает вовсе.
# Правится поэтому и то, и другое; лишним ни одно не бывает: под NEW переменные флагов буквы `/MD`
# уже не содержат, и замена в них — пустая операция.
#
# Утверждается результат, а не намерение: `assert_static_crt` читает таблицу импортов приехавшего
# пакета. Зависимость, ускользнувшая на `/MD`, приводит в него `msvcp140.dll` — и это находка.
if(NOT MSVC)
  return()
endif()

set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>"
    CACHE STRING "MSVC runtime library (spec #20 vertical 5: static CRT)" FORCE)

foreach(lang C CXX)
  foreach(cfg "" _DEBUG _RELEASE _RELWITHDEBINFO _MINSIZEREL)
    set(var "CMAKE_${lang}_FLAGS${cfg}")
    if(DEFINED ${var})
      string(REPLACE "/MDd" "/MTd" ${var} "${${var}}")
      string(REPLACE "/MD" "/MT" ${var} "${${var}}")
      set(${var} "${${var}}" CACHE STRING "" FORCE)
    endif()
  endforeach()
endforeach()
