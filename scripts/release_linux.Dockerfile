# Образ сборки Linux-пакета (спека #20, вертикаль 2, решение 5: только официальные источники,
# пиннутые и проверяемые). Контейнер здесь — способ дать macOS-машине владельца ЛИНУКС-ХОСТ, а не
# второй упаковщик: внутри работает тот же scripts/release.sh, что и на хосте.
#
# Базовый образ пиннут ДАЙДЖЕСТОМ, а не тегом `24.04`: тег переставляют на новый слепок каждым
# обновлением базы, то есть «тот же тег» через месяц — другой компилятор, другая libc и другая
# сумма пакета, а гейт воспроизводимости обвинил бы в этом наш код. Дайджест берётся у
# мультиархового индекса, поэтому один и тот же пин работает и на arm64 машине владельца, и на
# x86_64 раннере.
FROM ubuntu@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

# Версии apt-пакетов НЕ пиннуты, и это названо, а не умолчано: Ubuntu вычищает старые версии из
# pool, поэтому пин версии ломает сборку через месяц-другой не по вине дерева. Пин здесь — на
# уровне образа (строка выше), а сами пакеты приезжают из официального репозитория дистрибутива с
# проверкой подписи apt'ом, то есть требование «проверяемый источник» держится подписью, а не
# нашей верой в имя хоста.
#
# Набор — ровно тот, что ставит себе Linux-шаг CI (xorg-dev), плюс Wayland-заголовки: каталог
# сборки выбирает бэкенд окна ОДИН раз (LINUX_WAYLAND в CMakeLists), и образ, у которого есть
# только X11, молча запрещал бы вторую конфигурацию — а её требует гейт 6 спеки #13.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential cmake ninja-build git ca-certificates pkg-config python3 \
      xorg-dev libwayland-dev wayland-protocols libxkbcommon-dev \
 && rm -rf /var/lib/apt/lists/*

# Репозиторий монтируется в /src ТОЛЬКО ДЛЯ ЧТЕНИЯ, каталог сборки — в /build, готовый пакет
# уезжает в /out. Разведены они потому, что гейт 10 требует чистого `git status` после релиза:
# сборка, которой позволили писать в /src, оставила бы там свой каталог и чужие права на файлы.
WORKDIR /src
