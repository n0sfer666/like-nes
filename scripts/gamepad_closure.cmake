# SDK сохраняет LINK_ONLY для PRIVATE-рёбер статических библиотек: их тоже надо пройти.
function(no_window target)
  get_property(visited GLOBAL PROPERTY gamepad_closure_visited)
  if(target IN_LIST visited)
    return()
  endif()
  set_property(GLOBAL APPEND PROPERTY gamepad_closure_visited "${target}")
  get_target_property(links ${target} INTERFACE_LINK_LIBRARIES)
  foreach(link IN LISTS links)
    if(link MATCHES "^\\$<LINK_ONLY:(.+)>$")
      set(link "${CMAKE_MATCH_1}")
    endif()
    if(link MATCHES "glfw|input_native")
      message(FATAL_ERROR "gamepad-only closure pulls window: ${target} -> ${link}")
    endif()
    if(TARGET "${link}")
      no_window("${link}")
    endif()
  endforeach()
endfunction()
