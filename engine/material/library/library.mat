# Effect library of the engine (spec #18, decision 4).
#
# The shader field is the name of the FRAGMENT ENTRY POINT in sprite_effects.wgsl, and the guid of
# the material's shader asset is the hash of that same string. One name, so there is no convention
# between an asset name and an entry point for anyone to get wrong.
#
# Slot order is load-bearing: the baker packs parameters in declaration order into the lowest free
# run, and engine/material/library/sprite_effects.wgsl reads them by offset. Reordering rows here
# without touching the shader is caught by material_library_test, not by a black frame.
#
# The instances below exist to prove decision 2 (an instance is cheap): they share the shader and
# the pipeline of their base and differ only in values that travel in the instance buffer.

# Texture slot 2 is the sprite NORMAL MAP. Slots 0 and 1 belong to the material pass (albedo and
# the effect's aux texture); slot 2 is read by the normal pass of the lighting graph, which is why
# no fragment entry point in sprite_effects.wgsl samples it. A material that declares no normal
# slot is lit as flat (0,0,1) -- absence is a value here, not a gap.
material | flash | fs_flash | alpha
param | tint | color | raw | 1, 1, 1, 1
param | strength | scalar | fraction | 0
tex | normal | sprite_normal | 2

instance | flash_red | flash
set | tint | 1, 0.15, 0.1, 1

instance | flash_gold | flash
set | tint | 1, 0.85, 0.25, 1
set | strength | 0.5

material | outline | fs_outline | alpha
param | color | color | raw | 0, 0, 0, 1
param | thickness | scalar | pixels | 1
tex | normal | outline_normal | 2

instance | outline_danger | outline
set | color | 0.95, 0.1, 0.1, 1
set | thickness | 2

material | dissolve | fs_dissolve | alpha
param | edge_color | color | raw | 1, 0.55, 0.1, 1
param | threshold | scalar | fraction | 0
param | edge | scalar | fraction | 0.08
tex | noise | noise_rgba | 1

instance | dissolve_ash | dissolve
set | edge_color | 0.6, 0.6, 0.62, 1
set | edge | 0.16
