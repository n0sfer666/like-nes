if(WIN32)
  add_library(platform_mutex_probe STATIC platform_mutex_probe_none.cpp)
  target_include_directories(platform_mutex_probe PUBLIC ${CMAKE_CURRENT_SOURCE_DIR})
  add_library(platform_mutex_probe_control INTERFACE)
  target_link_libraries(platform_mutex_probe_control INTERFACE platform_mutex_probe)
elseif(APPLE)
  add_library(platform_mutex_probe SHARED platform_mutex_probe_apple.cpp)
  target_include_directories(platform_mutex_probe PUBLIC ${CMAKE_CURRENT_SOURCE_DIR})
  add_library(platform_mutex_probe_control STATIC platform_mutex_probe_control_posix.cpp)
  target_include_directories(platform_mutex_probe_control PUBLIC ${CMAKE_CURRENT_SOURCE_DIR})
  target_link_libraries(platform_mutex_probe_control PUBLIC platform_mutex_probe Threads::Threads)
else()
  add_library(platform_mutex_probe STATIC platform_mutex_probe_posix.cpp)
  target_include_directories(platform_mutex_probe PUBLIC ${CMAKE_CURRENT_SOURCE_DIR})
  # --wrap видит только ссылки главного executable, но не pthread-вызовы внутри других DSO.
  target_link_options(platform_mutex_probe INTERFACE
    "LINKER:--wrap=pthread_mutex_lock")
  add_library(platform_mutex_probe_control STATIC platform_mutex_probe_control_posix.cpp)
  target_include_directories(platform_mutex_probe_control PUBLIC ${CMAKE_CURRENT_SOURCE_DIR})
  target_link_libraries(platform_mutex_probe_control PUBLIC platform_mutex_probe Threads::Threads)
endif()
